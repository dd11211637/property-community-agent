ENV=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://property_agent:demo-password@localhost:5432/property_agent_demo
JWT_SECRET=change-me-before-production-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=3
DEEPSEEK_READ_TIMEOUT_SECONDS=12
OTEL_ENABLED=false
OTEL_SERVICE_NAME=property-agent
OTEL_EXPORTER_ENDPOINT=
OTEL_EXPORT_INTERVAL_MS=30000
RELEASE_SHA=
DEPLOYMENT_ENVIRONMENT=development
CERTIFICATION_WRITE_ENABLED=false
AGENT_STREAM_MAX_CONCURRENCY=16
AGENT_STREAM_SHUTDOWN_GRACE_SECONDS=15
AGENT_V2_NEW_CONVERSATION_ROLLOUT_BASIS_POINTS=0
AGENT_V2_ROLLOUT_SALT=
AGENT_V2_ROLLOUT_SALT_VERSION=unconfigured
AGENT_V2_ROLLOUT_CONFIG_VERSION=pr7c-default-v1
AGENT_V2_ELIGIBILITY_POLICY_VERSION=pr7c-eligibility-v1
AGENT_V2_NEW_CONVERSATION_FALLBACK_RUNTIME=v1
AGENT_V2_EMERGENCY_STOP=false
AGENT_V2_MODEL_CONFIG_APPROVED=false
